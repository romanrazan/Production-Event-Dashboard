# Copy to backend/.env and adjust. Never commit the real .env.
NODE_ENV=development
PORT=4000

# PostgreSQL. If DATABASE_URL is set it takes precedence over the DATABASE_* variables below.
# DATABASE_URL=postgresql://postgres:replace_me@127.0.0.1:55433/production_events
DATABASE_HOST=127.0.0.1
DATABASE_PORT=55433
DATABASE_USER=postgres
DATABASE_PASSWORD=replace_me
DATABASE_NAME=production_events

# Dedicated test database. Integration tests TRUNCATE all tables and refuse names not ending in _test.
TEST_DATABASE_URL=postgresql://postgres:replace_me@127.0.0.1:55433/production_events_test

# Comma-separated browser origins allowed to call the API (frontend runs on 3001).
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001

# MQTT worker (runs inside this backend). Candidate ID is a string: keep the leading zero.
MQTT_ENABLED=true
MQTT_BROKER_URL=mqtt://152.42.238.142:1883
MQTT_CANDIDATE_ID=07
# Heartbeat period; clamped to 1000..30000 ms.
MQTT_HEARTBEAT_MS=30000

# Local development only: broker used by `npm run mqtt:simulate` (never the examiner broker by default).
# For a fully local demo also set MQTT_BROKER_URL=mqtt://127.0.0.1:1883 and run `npm run mqtt:broker`.
MQTT_SIMULATOR_BROKER_URL=mqtt://127.0.0.1:1883
